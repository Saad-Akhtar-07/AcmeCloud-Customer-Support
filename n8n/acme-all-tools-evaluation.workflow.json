    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const test = $('Build Controlled Test Case').first().json;\nconst outputOf = name => {\n  try { return $(name).first().json ?? {}; } catch (error) { return { error: error.message }; }\n};\n\nconst knowledge = outputOf('Test 1 - Search Knowledge');\nconst customer = outputOf('Test 2 - Get Customer');\nconst subscription = outputOf('Test 3 - Get Subscription');\nconst events = outputOf('Test 4 - Get Recent Events');\nconst ticket = outputOf('Test 5 - Create or Update Ticket');\n\nconst retrievedDocumentCodes = Array.isArray(knowledge.results)\n  ? knowledge.results.map(result => result.document_code).filter(Boolean)\n  : [];\n\nconst checks = [\n  {\n    tool: 'search_knowledge',\n    passed: knowledge.found === true && Number(knowledge.result_count) > 0 && retrievedDocumentCodes.includes('KB-SUB-001'),\n    expected: 'At least one result including KB-SUB-001',\n    observed: { found: knowledge.found, result_count: knowledge.result_count, document_codes: retrievedDocumentCodes }\n  },\n  {\n    tool: 'get_customer',\n    passed: customer.found === true && customer.customer?.customer_id === test.customer_id && customer.hubspot?.found === true && customer.data_consistency === 'matched',\n    expected: 'C101 exists in Supabase and HubSpot with matching data',\n    observed: { found: customer.found, customer_id: customer.customer?.customer_id, hubspot_found: customer.hubspot?.found, data_consistency: customer.data_consistency, mismatched_fields: customer.mismatched_fields }\n  },\n  {\n    tool: 'get_subscription',\n    passed: subscription.found === true && subscription.customer_found === true && subscription.subscription?.customer_id === test.customer_id,\n    expected: 'C101 has a readable subscription',\n    observed: { found: subscription.found, customer_found: subscription.customer_found, subscription: subscription.subscription }\n  },\n  {\n    tool: 'get_recent_events',\n    passed: events.found === true && Number(events.event_count) > 0 && Array.isArray(events.events),\n    expected: 'C101 exists and has at least one recent event',\n    observed: { found: events.found, event_count: events.event_count, newest_event: events.events?.[0] ?? null }\n  },\n  {\n    tool: 'create_or_update_ticket',\n    passed: ticket.success === true && ['created', 'updated'].includes(ticket.action) && Boolean(ticket.ticket_id) && ticket.request_id === test.request_id,\n    expected: 'One test ticket is created or the existing request-ID ticket is updated',\n    observed: { success: ticket.success, action: ticket.action, ticket_id: ticket.ticket_id, request_id: ticket.request_id, pipeline_stage: ticket.pipeline_stage }\n  }\n];\n\nconst passedCount = checks.filter(check => check.passed).length;\nconst failedChecks = checks.filter(check => !check.passed).map(check => check.tool);\n\nreturn [{ json: {\n  test_name: test.test_name,\n  overall_status: passedCount === checks.length ? 'PASS' : 'FAIL',\n  all_tools_passed: passedCount === checks.length,\n  passed: passedCount,\n  failed: checks.length - passedCount,\n  failed_tools: failedChecks,\n  total_tools: checks.length,\n  total_latency_ms: Date.now() - test.started_at_ms,\n  checks,\n  outputs: {\n    search_knowledge: knowledge,\n    get_customer: customer,\n    get_subscription: subscription,\n    get_recent_events: events,\n    create_or_update_ticket: ticket\n  },\n  cleanup_note: `HubSpot contains the reusable test ticket with request ID ${test.request_id}. Delete it manually when you no longer need the evaluation fixture.`\n} }];"
      },
